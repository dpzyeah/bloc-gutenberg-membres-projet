{
	"apiVersion": 3,
	"name": "cerse/project-team",
	"title": "Équipe du projet",
	"category": "cerse-blocks",
	"icon": "groups",
	"description": "Ajoutez un titre et sélectionnez des membres de l'équipe (CPT cerse_equipe).",
	"textdomain": "cerse",
	"supports": {
		"html": false,
		"anchor": true,
		"color": {
			"background": false,
			"text": true,
			"link": false
		}
	},
	"attributes": {
		"groupTitle": {
			"type": "string",
			"default": ""
		},
		"members": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"id": { "type": "number" },
					"title": { "type": "string" },
					"featured_media": { "type": "number" },
					"image_url": { "type": "string" },
					"link": { "type": "string" }
				},
				"required": ["id", "title", "featured_media"]
			}
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"

}
